[Unit]
Description= Launch seabot2 algorithms

[Service]
#ExecStartPre=/bin/sleep 15
User=pi
Group=pi
UMask=022
ExecStart=/bin/zsh -c "source /home/pi/.zshrc && ros2 launch seabot2 seabot_launch.py"
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
