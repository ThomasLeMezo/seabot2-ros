<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>seabot2_simulator</name>
  <version>1.0.0</version>
  <description>Simulator for seabot2</description>
  <maintainer email="thomas.le_mezo@ensta-bretagne.org">Thomas Le Mézo</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>seabot2_msgs</depend>

  <depend>seabot2_density</depend>
  <depend>seabot2_kalman</depend>
  <depend>seabot2_mission</depend>
  <depend>rosbag2_cpp</depend>
  <depend>seabot2_piston_driver</depend>
  <depend>gpsd_client</depend>
  <depend>bluerobotics_ping_driver</depend>
  <depend>seabot2_depth_filter</depend>
  <depend>seabot2_depth_control</depend>
  <depend>seabot2_log_parameters</depend>
  <depend>seabot2_power_driver</depend>
  <depend>pressure_bme280_driver</depend>
  <depend>temperature_tsys01_driver</depend>
  <depend>seabot2_safety</depend>
  <depend>seabot2_temperature_profile</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
